<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace必须和Mapper接口的全类名一致 -->
<mapper namespace="com.ailab.back.mapper.UserMapper">

    <!-- 通用结果集映射，避免重复编写字段映射 -->
    <resultMap id="UserResultMap" type="com.ailab.back.Entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="email" property="email"/>
        <result column="avatar_path" property="avatarPath"/>
        <result column="role" property="role"/>
        <result column="status" property="status"/>
        <result column="last_login_time" property="lastLoginTime"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
    </resultMap>

    <!-- 1. 根据用户名查询用户 -->
    <select id="selectUserByUsername" resultMap="UserResultMap">
        SELECT
            id, username, password_hash, email, avatar_path,
            role, status, last_login_time, created_time, updated_time
        FROM user
        WHERE username = #{username}
    </select>

    <!-- 2. 根据ID修改用户信息（选择性更新） -->
    <update id="updateUserById">
        UPDATE user
        <set>
            <if test="user.username != null and user.username != ''">
                username = #{user.username},
            </if>
            <if test="user.passwordHash != null and user.passwordHash != ''">
                password_hash = #{user.passwordHash},
            </if>
            <if test="user.email != null and user.email != ''">
                email = #{user.email},
            </if>
            <if test="user.avatarPath != null and user.avatarPath != ''">
                avatar_path = #{user.avatarPath},
            </if>
            <if test="user.role != null and user.role != ''">
                role = #{user.role},
            </if>
            <if test="user.status != null">
                status = #{user.status},
            </if>
            <if test="user.lastLoginTime != null">
                last_login_time = #{user.lastLoginTime},
            </if>
            <!-- 更新时间自动刷新 -->
            updated_time = NOW()
        </set>
        WHERE id = #{user.id}
    </update>

    <!-- 3. 批量查询用户数据（非分页） -->
    <select id="selectUserBatch" resultMap="UserResultMap">
        SELECT
        id, username, password_hash, email, avatar_path,
        role, status, last_login_time, created_time, updated_time
        FROM user
        <where>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY created_time DESC
    </select>

    <!-- 3. 批量查询用户数据（分页版） -->
    <select id="selectUserBatchByPage" resultMap="UserResultMap">
        SELECT
        id, username, password_hash, email, avatar_path,
        role, status, last_login_time, created_time, updated_time
        FROM user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY created_time DESC
    </select>

    <!-- 4. 根据ID删除用户 -->
    <delete id="deleteUserById">
        DELETE FROM user WHERE id = #{id}
    </delete>

    <!-- 5. 更新用户最后登录时间 -->
    <update id="updateLastLoginTime">
        UPDATE user
        SET last_login_time = #{lastLoginTime},
            updated_time = NOW()
        WHERE id = #{id}
    </update>
</mapper>